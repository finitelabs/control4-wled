        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>LED Count</name>
        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Segments</name>
        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
