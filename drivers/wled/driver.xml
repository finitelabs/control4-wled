        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Product</name>
        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Firmware Version</name>
        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
      <property>
