        <minimum>1900</minimum>
        <maximum>10091</maximum>
        <default>2700</default>
        <description>The color temperature of the strip's warmest white.</description>
      </property>
      <property>
        <name>Cool White (K)</name>
        <type>RANGED_INTEGER</type>
        <minimum>1900</minimum>
        <maximum>10091</maximum>
        <default>6500</default>
        <description>The color temperature of the strip's coolest white.</description>
      </property>
      <property>
        <name>Device Info</name>
        <type>LABEL</type>
        <default>Device Info</default>
      </property>
      <property>
        <name>Name</name>
        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
      <property>
