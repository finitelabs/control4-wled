<devicedata>
  <name>WLED Segment</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>WLED Segment</model>
  <creator>Derek Miller</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>11/02/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Lighting</category>
  </composer_categories>
  <conditionals/>
  <events/>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #endif -->
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>DYNAMIC_LIST</type>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <property>
        <name>Cloud Monitoring</name>
        <type>LIST</type>
        <default>Enabled</default>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <description>Sends memory and error reports to Finite Labs so we can fix driver problems.</description>
      </property>
      <!-- #endif -->
      <property>
        <name>Light Settings</name>
        <type>LABEL</type>
        <default>Light Settings</default>
      </property>
      <property>
        <name>Warm White (K)</name>
        <type>RANGED_INTEGER</type>
        <minimum>1900</minimum>
        <maximum>10091</maximum>
        <default>2700</default>
        <description>The color temperature of the strip's warmest white.</description>
      </property>
      <property>
        <name>Cool White (K)</name>
        <type>RANGED_INTEGER</type>
        <minimum>1900</minimum>
        <maximum>10091</maximum>
        <default>6500</default>
        <description>The color temperature of the strip's coolest white.</description>
      </property>
      <property>
        <name>Segment Info</name>
        <type>LABEL</type>
        <default>Segment Info</default>
      </property>
      <property>
        <name>Segment</name>
        <type>STRING</type>
        <default>N/A</default>
        <readonly>true</readonly>
      </property>
    </properties>
    <commands/>
    <actions>
      <!-- #ifdef DRIVERCENTRAL -->
      <action>
        <name>Diagnostics Snapshot</name>
        <command>DiagnosticsSnapshot</command>
      </action>
      <!-- #endif -->
    </actions>
  </config>
  <!--
    A dynamic capability overrides these in both directions, so a later layer that reads the
    controller's capabilities can correct a light that lacks one. The dimming tier is True
    because Composer's test panel needs static and dynamic; the color tier stays off until the
    controller reports color.
  -->
  <!-- The light's capabilities are the build's, written from the profile the driver gives Light.new. -->
  <capabilities></capabilities>
  <proxies>
    <proxy proxybindingid="5001" primary="True" name="WLED Segment">light_v2</proxy>
  </proxies>
  <connections>
    <connection>
      <id>300</id>
      <facing>6</facing>
      <connectionname>On Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>BUTTON_LINK</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>301</id>
      <facing>6</facing>
      <connectionname>Toggle Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>BUTTON_LINK</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>302</id>
      <facing>6</facing>
      <connectionname>Off Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>BUTTON_LINK</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Light</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>LIGHT_V2</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>5002</id>
      <facing>6</facing>
      <connectionname>WLED Controller</connectionname>
      <type>2</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>WLED_SEGMENT</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
  </connections>
</devicedata>
